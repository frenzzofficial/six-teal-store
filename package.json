{
  "name": "six-teal-store",
  "version": "2.0.2",
  "description": "Six Teal Store is a premium modern e-commerce platform that offers a wide range of products and services to customers worldwide.",
  "private": true,
  "scripts": {
    "themes:build": "bun run src/packages/scripts/build-themes.ts",
    "predev": "bun run themes:build",
    "prebuild": "bun run themes:build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --fix .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "verify": "bun run lint:fix && bun run format && bun run check && bun run typecheck",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.56.0",
    "next-themes": "^0.4.6",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "@base-ui/react": "^1.9.0",
    "cn": "^0.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
