# Six Teal Store — environment variables
# Copy this file to `.env.local` for local dev.
# Every var here is validated by zod in src/packages/env/*.ts — that trio of
# files (app.env.ts, client.env.ts, public.env.ts) is the single source of
# truth for shape/defaults; this file just documents & seeds them.

# --- Server (src/packages/env/app.env.ts) ---
NODE_ENV=development
PORT=3000

# --- Client origin (src/packages/env/client.env.ts) ---
NEXT_PUBLIC_CLIENT_ORIGIN=http://localhost:7164
NEXT_PUBLIC_CLIENT_PREFIX=/app

# --- Public / app metadata (src/packages/env/public.env.ts) ---
NEXT_PUBLIC_APP_NAME="Six Teal Store"
NEXT_PUBLIC_APP_VERSION=2.0.0
NEXT_PUBLIC_APP_DESCRIPTION="Six Teal Store is a modern e-commerce platform that offers a wide range of products and services to customers worldwide."

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_TITLE="Six Teal Store - Your Premium Luxury Destination"

NEXT_PUBLIC_LOGO_URL=/logo.png
NEXT_PUBLIC_OG_IMAGE_URL=

NEXT_PUBLIC_ACTIVE_THEME=system

NEXT_PUBLIC_INSTAGRAM=https://instagram.com/sixtealstore
NEXT_PUBLIC_TWITTER=https://twitter.com/sixtealstore
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/company/sixtealstore/

NEXT_PUBLIC_AUTHOR_NAME=@sixtealstore
NEXT_PUBLIC_AUTHOR_EMAIL=contact@sixteal.store

# --- Backend connection (src/packages/env/api.env.ts, next.config.ts) ---
# "internal" (recommended): the browser calls this app's own /api/*, and next.config.ts proxies
# it to the backend, so the session and CSRF cookies are first-party.
NEXT_PUBLIC_API_MODE=internal

# Server-only. Where the Next server reaches the backend (no trailing slash, no /api).
#   local:       http://localhost:7164
#   production:  https://<your-backend-host>
API_PROXY_TARGET=http://localhost:7164

# Only for NEXT_PUBLIC_API_MODE=external (cross-origin; needs SameSite=None cookies and CORS):
# NEXT_PUBLIC_API_URL=https://<your-backend-host>/api

# NEXT_PUBLIC_API_TIMEOUT_MS=15000
